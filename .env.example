# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# ===========================================
# Square Payments (credit purchases)
# ===========================================
# sandbox while testing, production when you go live.
SQUARE_ENVIRONMENT=sandbox
# Secret - server only. Never sent to the browser.
SQUARE_ACCESS_TOKEN=
# Public - the browser SDK needs these two.
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=USD
# Pin the Square API version you tested against.
SQUARE_API_VERSION=2024-10-17

# ===========================================
# Credit cost per metered API call
# ===========================================
CREDIT_COST_PARSE_RESUME=1
CREDIT_COST_PARSE_RESUME_TEXT=1
CREDIT_COST_GITHUB_ANALYSIS=2
CREDIT_COST_RANKED_CANDIDATES=2
CREDIT_COST_GENERATE_TEST=3
CREDIT_COST_EVALUATE_TEST=3
